{
  "pixelplein": {
    "color": {
      "ice": {
        "$type": "color",
        "$value": "#d8eafb",
        "$description": "Achtergrond van elk scherm"
      },
      "ink": {
        "$type": "color",
        "$value": "#0e2a56",
        "$description": "Tekst, kopbalk, grote donkere vlakken"
      },
      "butter": {
        "$type": "color",
        "$value": "#fbe8b5",
        "$description": "Gekozen, aan de beurt, badge; koppen op Dark Blue"
      },
      "red": {
        "$type": "color",
        "$value": "#b5182b",
        "$description": "Hoofdknop (één per scherm), een enkel accentwoord"
      },
      "red-press": {
        "$type": "color",
        "$value": "#94121f",
        "$description": "Hover en indrukken van de rode knop"
      },
      "ice-soft": {
        "$type": "color",
        "$value": "#eaf3fd",
        "$description": "Hover, kleine vlakken"
      },
      "butter-deep": {
        "$type": "color",
        "$value": "#f6d98a",
        "$description": ""
      },
      "butter-soft": {
        "$type": "color",
        "$value": "#fdf4dc",
        "$description": "Uitgelichte kaart"
      },
      "paper": {
        "$type": "color",
        "$value": "#fffbf2",
        "$description": "Menubalk"
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Kaarten, tegels, invoervelden"
      },
      "ink-muted": {
        "$type": "color",
        "$value": "#4a5d80",
        "$description": "Lopende en kleine tekst (contrast 5,4:1)"
      },
      "ink-dim": {
        "$type": "color",
        "$value": "#6e7c99",
        "$description": "Gedimd deel van grote koppen"
      },
      "on-ink-dim": {
        "$type": "color",
        "$value": "#8fa3c7",
        "$description": "Gedimde tekst op Dark Blue"
      }
    },
    "font": {
      "display": {
        "$type": "fontFamily",
        "$value": "\"Fraunces\", \"Iowan Old Style\", Georgia, serif"
      },
      "hero": {
        "$type": "fontFamily",
        "$value": "\"Bricolage Grotesque\", \"Figtree\", system-ui, sans-serif"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "\"Figtree\", \"Segoe UI\", system-ui, -apple-system, sans-serif"
      }
    },
    "radius": {
      "pill": {
        "$type": "dimension",
        "$value": "999px"
      },
      "card": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "vel": {
        "$type": "dimension",
        "$value": "clamp(1.75rem, 0.75rem + 4vw, 5rem)"
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "300ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "600ms"
      }
    },
    "easing": {
      "out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "bounce": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      }
    }
  }
}
